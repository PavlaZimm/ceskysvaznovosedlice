# ---------------------------------------------------------------------------
# Nastavení webu. Na Vercelu se zadává v Project → Settings → Environment
# Variables. Pro pokusy na vlastním počítači zkopírujte tenhle soubor
# jako `.env.local` a doplňte hodnoty.
# ---------------------------------------------------------------------------

# Heslo do správy webu (/sprava). Zvolte dlouhé a nesdílejte ho e-mailem.
SPRAVA_HESLO=

# Přístup k repozitáři, kam správa ukládá texty a fotky.
# Token se vytvoří na https://github.com/settings/personal-access-tokens
#   - typ: Fine-grained token
#   - Repository access: pouze repozitář tohoto webu
#   - Permissions → Repository permissions → Contents: Read and write
# Bez tokenu se změny ukládají jen na disk (hodí se při vývoji).
GITHUB_TOKEN=
GITHUB_REPO=PavlaZimm/ceskysvaznovosedlice
GITHUB_BRANCH=main

# Adresa webu. Doplňte, až budete mít vlastní doménu — bez ní se použije
# adresa přidělená Vercelem.
# NEXT_PUBLIC_URL_WEBU=https://csz-novosedlice.cz
